# Raw source archive — contains real, unredacted email addresses (see docs/data-structures.md).
# Never committed; ADR-0008/FR-4 scrub PII from the canonical dataset and site output,
# but that guarantee is worthless if the raw source itself gets pushed to a public repo.
mail_archives/

# Local/OS noise
.DS_Store
.vscode/
node_modules/
.venv/
__pycache__/
*.pyc

# Future Eleventy build output (dd.md §10) — generated, not source
_site/
.cache/
_site/pagefind/

# Playwright's own run artifacts (screenshots/traces on failure) — not source
test-results/

# Lighthouse CI's own report output — not source
.lighthouseci/
.lighthouseci-desktop/
