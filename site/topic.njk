---
layout: layouts/base.njk
pagination:
  data: posts.topics
  size: 1
  alias: topic
permalink: "/topics/{{ topic.slug }}/"
---
<h1>{{ topic.subject }} · {{ topic.posts.length }} post{{ "s" if topic.posts.length != 1 }}</h1>
<p class="lede">Every post sharing this normalized subject, in order.</p>

{% for post in topic.posts %}
<div class="thread-post{{ ' is-current' if loop.first }}">
  <a class="post-title" href="{{ ('/posts/' + post.id + '/') | url }}">{{ post.subject }}</a>
  <span class="post-meta">{{ post.author.display_name }} · {{ post.date_utc | formatDate }}</span>
</div>
{% endfor %}
